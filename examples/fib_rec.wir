func @fib_rec(i32 %n) -> i32 {
entry:
  %is_zero = icmp eq i32 %n, 0
  condbr i32 %is_zero, zero, check_one
zero:
  ret i32 0
check_one:
  %is_one = icmp eq i32 %n, 1
  condbr i32 %is_one, one, recurse
one:
  ret i32 1
recurse:
  %n1 = sub i32 %n, 1
  %n2 = sub i32 %n, 2
  %a = call i32 @fib_rec(i32 %n1)
  %b = call i32 @fib_rec(i32 %n2)
  %sum = add i32 %a, %b
  ret i32 %sum
}
