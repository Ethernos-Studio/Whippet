func @store42(ptr %p) {
entry:
  store i32 42, ptr %p
  ret
}

func @use_ptr() -> i32 {
entry:
  %p = alloca i32
  call void @store42(ptr %p)
  %v = load i32, ptr %p
  ret i32 %v
}

func @memory(i32 %x) -> i32 {
entry:
  %p = alloca i32
  store i32 %x, ptr %p
  %v = load i32, ptr %p
  %q = ptradd ptr %p, i64 0
  %w = load i32, ptr %q
  %s = add i32 %v, %w
  ret i32 %s
}
