func @store42(ptr %p) {
entry:
  store i32 42, ptr %p
  ret
}

func @use_ptr() -> i32 {
entry:
  %p = alloca i32
  call void @store42(ptr %p)
  %v = load i32, ptr %p
  ret i32 %v
}

func @memory(i32 %x) -> i32 {
entry:
  %p = alloca i32
  store i32 %x, ptr %p
  %v = load i32, ptr %p
  %q = ptradd ptr %p, i64 0
  %w = load i32, ptr %q
  %s = add i32 %v, %w
  ret i32 %s
}

func @widths(ptr %p) -> i32 {
entry:
  store i8 255, ptr %p
  %a = load i8, ptr %p
  %p2 = ptradd ptr %p, i64 2
  store i16 65535, ptr %p2
  %b = load i16, ptr %p2
  %aa = zext i8 %a to i32
  %bb = zext i16 %b to i32
  %sum = add i32 %aa, %bb
  ret i32 %sum
}

func @wide(ptr %p) -> i64 {
entry:
  store i64 1234605616436508552, ptr %p
  %v = load i64, ptr %p
  ret i64 %v
}
