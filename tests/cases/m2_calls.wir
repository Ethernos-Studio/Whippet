declare i32 @putchar(i32 %c)

func @fib_rec(i32 %n) -> i32 {
entry:
  %is_zero = icmp eq i32 %n, 0
  condbr i32 %is_zero, zero, check_one
zero:
  ret i32 0
check_one:
  %is_one = icmp eq i32 %n, 1
  condbr i32 %is_one, one, recurse
one:
  ret i32 1
recurse:
  %n1 = sub i32 %n, 1
  %n2 = sub i32 %n, 2
  %a = call i32 @fib_rec(i32 %n1)
  %b = call i32 @fib_rec(i32 %n2)
  %sum = add i32 %a, %b
  ret i32 %sum
}

func @sum5(i32 %a, i32 %b, i32 %c, i32 %d, i32 %e) -> i32 {
entry:
  %ab = add i32 %a, %b
  %cd = add i32 %c, %d
  %abcd = add i32 %ab, %cd
  %all = add i32 %abcd, %e
  ret i32 %all
}

func @sum6(i32 %a, i32 %b, i32 %c, i32 %d, i32 %e, i32 %f) -> i32 {
entry:
  %ab = add i32 %a, %b
  %cd = add i32 %c, %d
  %ef = add i32 %e, %f
  %abcd = add i32 %ab, %cd
  %all = add i32 %abcd, %ef
  ret i32 %all
}

func @call_sum6() -> i32 {
entry:
  %r = call i32 @sum6(i32 1, i32 2, i32 3, i32 4, i32 5, i32 6)
  ret i32 %r
}

func @call_sum5() -> i32 {
entry:
  %r = call i32 @sum5(i32 1, i32 2, i32 3, i32 4, i32 5)
  ret i32 %r
}

func @call_sum5_2(i32 %x) -> i32 {
entry:
  %r = call i32 @sum5(i32 %x, i32 2, i32 3, i32 4, i32 5)
  ret i32 %r
}

func @forward5(i32 %a, i32 %b, i32 %c, i32 %d, i32 %e) -> i32 {
entry:
  %r = call i32 @sum5(i32 %a, i32 %b, i32 %c, i32 %d, i32 %e)
  ret i32 %r
}

func @add2(i32 %x) -> i32 {
entry:
  %r = add i32 %x, 2
  ret i32 %r
}

func @add64(i64 %a, i64 %b) -> i64 {
entry:
  %r = add i64 %a, %b
  ret i64 %r
}

func @call_add64() -> i64 {
entry:
  %r = call i64 @add64(i64 2, i64 3)
  ret i64 %r
}

func @id8(i8 %x) -> i8 {
entry:
  ret i8 %x
}

func @call_id8(i32 %x) -> i32 {
entry:
  %a = trunc i32 %x to i8
  %r = call i8 @id8(i8 %a)
  %e = sext i8 %r to i32
  ret i32 %e
}

func @apply(ptr %fp, i32 %x) -> i32 {
entry:
  %r = call i32 %fp(i32 %x)
  ret i32 %r
}

func @emit_A() -> i32 {
entry:
  %r = call i32 @putchar(i32 65)
  ret i32 %r
}
